[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/model_purpose_card.gd" id="1_card"]
[ext_resource type="Theme" path="res://theme/app_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://scenes/ui/components/unified_dropdown.tscn" id="3_dropdown"]

[node name="ModelPurposeCard" type="PanelContainer"]
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"SettingsCard"
script = ExtResource("1_card")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Column"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PurposeTitle" type="Label" parent="Column/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SettingsCardTitle"
text = "模型用途"

[node name="Enabled" type="CheckBox" parent="Column/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SettingsCheckBox"
text = "使用自己的 API Key"

[node name="Requirements" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SettingsHelpText"
autowrap_mode = 3

[node name="Description" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="Fields" type="VBoxContainer" parent="Column"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 8

[node name="ProviderLabel" type="Label" parent="Column/Fields"]
layout_mode = 2
theme_type_variation = &"SettingsFieldLabel"
text = "服务商名称"

[node name="provider" type="LineEdit" parent="Column/Fields"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_type_variation = &"SettingsLineEdit"

[node name="BaseUrlLabel" type="Label" parent="Column/Fields"]
layout_mode = 2
theme_type_variation = &"SettingsFieldLabel"
text = "Base URL（例如 https://example.com/v1）"

[node name="base_url" type="LineEdit" parent="Column/Fields"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_type_variation = &"SettingsLineEdit"

[node name="ApiKeyLabel" type="Label" parent="Column/Fields"]
layout_mode = 2
theme_type_variation = &"SettingsFieldLabel"
text = "API Key"

[node name="api_key" type="LineEdit" parent="Column/Fields"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_type_variation = &"SettingsLineEdit"
secret = true

[node name="ModelLabel" type="Label" parent="Column/Fields"]
layout_mode = 2
theme_type_variation = &"SettingsFieldLabel"
text = "模型名称"

[node name="ModelName" type="LineEdit" parent="Column/Fields"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_type_variation = &"SettingsLineEdit"

[node name="Json" type="CheckBox" parent="Column/Fields"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SettingsCheckBox"
text = "声明支持 JSON 输出"

[node name="Thinking" type="CheckBox" parent="Column/Fields"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SettingsCheckBox"
text = "声明支持 thinking"

[node name="ParamsLabel" type="Label" parent="Column/Fields"]
layout_mode = 2
theme_type_variation = &"SettingsFieldLabel"
text = "高级 JSON 参数（非流式）"

[node name="Params" type="TextEdit" parent="Column/Fields"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
theme_type_variation = &"SettingsTextEdit"
wrap_mode = 1

[node name="CopyRow" type="HBoxContainer" parent="Column/Fields"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="CopySlot" parent="Column/Fields/CopyRow" instance=ExtResource("3_dropdown")]
unique_name_in_owner = true
layout_mode = 2

[node name="CopyButton" type="Button" parent="Column/Fields/CopyRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_type_variation = &"SettingsButton"
text = "复制该用途配置"

[node name="TestButton" type="Button" parent="Column/Fields"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_type_variation = &"SettingsButton"
text = "手动测试当前配置"

[node name="CardStatus" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SettingsHelpText"
autowrap_mode = 3
