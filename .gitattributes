# 默认：自动检测文本文件，提交时统一为 LF
* text=auto eol=lf

# 强制某些文件为 LF（避免脚本/配置文件在跨平台时出问题）
*.sh        text eol=lf
*.py        text eol=lf
*.gd        text eol=lf
*.godot     text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.cfg       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf

# Windows 专用文件保持 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# 二进制文件，禁止 Git 做任何换行转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.zip       binary
*.7z        binary
*.exe       binary
*.dll       binary
*.so        binary
*.dylib     binary
*.pck       binary